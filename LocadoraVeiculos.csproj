<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <!-- Models/ e Data/ vêm de LocadoraVeiculos_Etapa1; nenhum obj/ ou bin/ de qualquer pasta deve ser compilado. -->
  <ItemGroup>
    <Compile Remove="**/obj/**;**/bin/**" />
    <EmbeddedResource Remove="**/obj/**;**/bin/**" />
    <None Remove="**/obj/**;**/bin/**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.20" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.20" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.20"><PrivateAssets>all</PrivateAssets></PackageReference>
  </ItemGroup>
</Project>
